#!/usr/bin/env bash
# vpn — wgcf/WARP control with nftables kill switch
# usage: vpn up | vpn down | vpn restart | vpn status

[ "$EUID" -ne 0 ] && exec sudo "$0" "$@"

G=$'\033[0;32m'
R=$'\033[0;31m'
Y=$'\033[1;33m'
B=$'\033[1m'
N=$'\033[0m'

cmd_up() {
    echo ""
    echo "${B}Starting VPN...${N}"
    echo "  ▶ Loading kill switch..."
    nft -f /etc/nftables.conf
    echo "  ▶ Starting tunnel..."
    systemctl start wg-quick@wgcf
    echo "  ${G}✓ VPN is UP — your IP is hidden.${N}"
    echo "  ${Y}  Internet stops if the tunnel drops.${N}"
    echo ""
}

cmd_down() {
    echo ""
    echo "${B}Stopping VPN...${N}"
    echo "  ▶ Stopping tunnel..."
    systemctl stop wg-quick@wgcf 2>/dev/null || true
    echo "  ▶ Removing kill switch..."
    nft delete table inet killswitch 2>/dev/null || true
    echo "  ${R}✓ VPN is DOWN — internet uses your real IP.${N}"
    echo "  ${Y}  Type 'vpn up' to restore.${N}"
    echo ""
}

cmd_restart() {
    echo ""
    echo "${B}Restarting tunnel...${N}"
    echo "  ▶ Kill switch stays active."
    systemctl restart wg-quick@wgcf
    echo "  ${G}✓ Done.${N}"
    echo ""
}

cmd_status() {
    TUNNEL="DOWN"
    KILL="INACTIVE"
    ip link show wgcf &>/dev/null && TUNNEL="UP"
    nft list table inet killswitch &>/dev/null && KILL="ACTIVE"

    echo ""
    echo "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "   VPN Status"
    echo "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    [ "$TUNNEL" = "UP" ] \
        && echo "   Tunnel (wgcf)  ${G}UP ✓${N}" \
        || echo "   Tunnel (wgcf)  ${R}DOWN ✗${N}"

    [ "$KILL" = "ACTIVE" ] \
        && echo "   Kill switch    ${G}ACTIVE ✓${N}" \
        || echo "   Kill switch    ${R}INACTIVE ✗${N}"

    echo "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "   Public info:"
    curl -s --max-time 6 https://cloudflare.com/cdn-cgi/trace 2>/dev/null \
        | grep -E "^(ip|warp|loc)=" | sed 's/^/     /' \
        || echo "     (no internet)"
    echo "  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
}

case "${1:-status}" in
    up)      cmd_up ;;
    down)    cmd_down ;;
    restart) cmd_restart ;;
    status)  cmd_status ;;
    *)
        echo ""
        echo "  Usage: vpn up | vpn down | vpn status | vpn restart"
        echo ""
        exit 1
        ;;
esac
