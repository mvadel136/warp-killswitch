#!/usr/bin/env bash
set -euo pipefail

[ "$EUID" -ne 0 ] && exec sudo "$0" "$@"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    G=$'\033[0;32m'
    R=$'\033[0;31m'
    Y=$'\033[1;33m'
    N=$'\033[0m'
else
    G=""
    R=""
    Y=""
    N=""
fi

cmd_up() {
    echo "Starting VPN..."
    echo "Loading kill switch..."
    if ! nft -f /etc/nftables.d/killswitch.nft; then
        if nft list table inet killswitch &>/dev/null; then
            echo "${R}Failed to reload kill switch rules.${N}"
            echo "${Y}An older kill switch is still active, traffic is still blocked, just not refreshed.${N}"
        else
            echo "${R}Failed to load nftables rules. VPN not started, no kill switch active.${N}"
        fi
        exit 1
    fi
    if ! nft list table inet killswitch &>/dev/null; then
        echo "${R}Kill switch table missing after load. No kill switch active.${N}"
        echo "${Y}/etc/nftables.d/killswitch.nft did not produce a killswitch table. Re-run install.sh.${N}"
        exit 1
    fi
    echo "Starting tunnel..."
    if ! systemctl start wg-quick@wgcf; then
        echo "${R}Tunnel failed to start.${N}"
        echo "${Y}Kill switch is still active, traffic is blocked, not leaking.${N}"
        echo "${Y}Check: systemctl status wg-quick@wgcf${N}"
        exit 1
    fi
    echo "${G}VPN is up. Your IP is hidden.${N}"
    echo "Internet stops if the tunnel drops."
}

cmd_down() {
    echo "Stopping VPN..."
    systemctl stop wg-quick@wgcf 2>/dev/null || true
    nft delete table inet killswitch 2>/dev/null || true
    echo "${R}VPN is down. Internet uses your real IP.${N}"
}

cmd_restart() {
    echo "Restarting tunnel. Kill switch stays active."
    if ! systemctl restart wg-quick@wgcf; then
        echo "${R}Restart failed. Kill switch still active, traffic blocked.${N}"
        echo "${Y}Check: systemctl status wg-quick@wgcf${N}"
        exit 1
    fi
    echo "${G}Done.${N}"
}

cmd_status() {
    TUNNEL="down"
    KILL="inactive"
    ip link show wgcf &>/dev/null && TUNNEL="up"
    nft list table inet killswitch &>/dev/null && KILL="active"

    [ "$TUNNEL" = "up" ] \
        && echo "tunnel (wgcf): ${G}up${N}" \
        || echo "tunnel (wgcf): ${R}down${N}"

    [ "$KILL" = "active" ] \
        && echo "kill switch:   ${G}active${N}" \
        || echo "kill switch:   ${R}inactive${N}"

    echo "public info:"
    curl -s --max-time 6 https://cloudflare.com/cdn-cgi/trace 2>/dev/null \
        | grep -E "^(ip|warp|loc)=" | sed 's/^/  /' \
        || echo "  (no internet)"
}

case "${1:-status}" in
    up)      cmd_up ;;
    down)    cmd_down ;;
    restart) cmd_restart ;;
    status)  cmd_status ;;
    *)
        echo "usage: vpn up | vpn down | vpn status | vpn restart"
        exit 1
        ;;
esac
